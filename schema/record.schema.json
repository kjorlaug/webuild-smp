{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WE BUILD SMP 2.0 participant record",
  "type": "object",
  "required": ["participant", "services"],
  "additionalProperties": false,
  "properties": {
    "participant": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": {"type": "string", "minLength": 1},
        "value": {"type": "string", "pattern": "^\\S+$"},
        "name": {"type": "string", "description": "Informational only, not published"},
        "registrant": {"type": "string", "description": "Pilot partner responsible for this record"}
      }
    },
    "services": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["service", "processMetadata"],
        "additionalProperties": false,
        "properties": {
          "service": {"$ref": "#/$defs/identifier"},
          "processMetadata": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["endpoints"],
              "additionalProperties": false,
              "properties": {
                "process": {
                  "allOf": [{"$ref": "#/$defs/identifier"}],
                  "properties": {"scheme": true, "value": true,
                                 "roles": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}}
                },
                "endpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/endpoint"}}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "object", "required": ["value"],
      "properties": {"scheme": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
    },
    "endpoint": {
      "type": "object",
      "required": ["transportProfile", "address", "expirationDate", "certificates"],
      "additionalProperties": false,
      "properties": {
        "transportProfile": {"type": "string"},
        "address": {"type": "string", "pattern": "^https://"},
        "description": {"type": "string"},
        "contact": {"type": "string"},
        "activationDate": {"description": "YYYY-MM-DD"},
        "expirationDate": {"description": "YYYY-MM-DD; must not exceed pilot_end_date"},
        "certificates": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["certificate"], "additionalProperties": false,
            "properties": {
              "certificate": {"type": "string", "description": "Path to PEM (relative to record or repo root) or inline PEM"},
              "typeCode": {"type": "string"},
              "description": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
